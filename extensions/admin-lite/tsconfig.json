{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "jsx": "react",
    "outDir": "./dist",
    "strictNullChecks": true,
    "rootDir": "./src"
  },
  "include": ["src"]
}
